# Copy this file to .env and fill in real values.
# Never commit .env — it may contain secrets.

# --- LLM (Groq) ---
# Get a key at https://console.groq.com/keys
LLM_API_KEY=your_groq_api_key_here
# Alias also accepted by the app:
# GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# --- Dataset ---
# Verified public HF mirror of the Bangalore Zomato restaurants dataset
HF_DATASET_ID=jason1966/absin7_zomato-bangalore-dataset
HF_DATASET_REVISION=main

# --- Recommendation tuning ---
CANDIDATE_CAP=20

# --- CORS (Railway / production) ---
# Comma-separated browser origins allowed to call the API.
# After Vercel deploy, add your production URL, e.g.:
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# On Railway, Vercel hosts (https://*.vercel.app) are allowed by default when unset.
# Override explicitly if needed, or set to empty string in Railway to disable:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

